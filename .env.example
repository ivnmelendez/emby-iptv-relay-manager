# === URL pública del servidor ===
# IP o dominio que Emby y clientes externos usan para streams y M3U.
BASE_URL=http://TU_IP_O_DOMINIO:8080

# === Puerto nginx ===
NGINX_PORT=8080

# === Proveedor IPTV (Xtream Codes) ===
IPTV_HOST=http://proveedor:puerto
IPTV_USERNAME=tu_usuario
IPTV_PASSWORD=tu_password

# === Filtros de grupo (matching parcial, case-insensitive) ===
GROUP_FILTERS=["EVENTOS","SPORTS","DEPORT","PPV","LIVE"]

# === Límite de relays IPTV simultáneos ===
MAX_ACTIVE_STREAMS=3

# === Paths runtime (dentro de contenedores) ===
# STREAMS_DIR es el root compartido entre backend y nginx.
# Backend escribe en $STREAMS_DIR/live/  y  $STREAMS_DIR/offline/
# Nginx sirve /var/www/streams/ (mismo dir del host ./streams/)
# No cambiar salvo que cambies el docker-compose.yml también.
STREAMS_DIR=/app/streams
DATA_DIR=/app/data

# === FFmpeg ===
FFMPEG_BIN=/usr/bin/ffmpeg
HLS_TIME=4
HLS_LIST_SIZE=6
