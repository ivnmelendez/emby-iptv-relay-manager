# === URL pública del servidor ===
# IP o dominio que Emby y clientes externos usan para acceder a streams/M3U.
BASE_URL=http://TU_IP_O_DOMINIO:8080

# === Puerto nginx ===
NGINX_PORT=8080

# === Proveedor IPTV (Xtream Codes) ===
IPTV_HOST=http://proveedor:puerto
IPTV_USERNAME=tu_usuario
IPTV_PASSWORD=tu_password

# === Filtros de grupo (matching parcial, case-insensitive) ===
# JSON array. Ejemplos que hacen match: "TV || EVENTOS DEPORTIVOS", "PPV UFC", "SPORTS EVENTS"
GROUP_FILTERS=["EVENTOS","SPORTS","DEPORT","PPV","LIVE"]

# === Límite de relays IPTV simultáneos ===
MAX_ACTIVE_STREAMS=3

# === Rutas internas (no cambiar salvo migración de estructura) ===
HLS_DIR=/app/streams/live
OFFLINE_DIR=/app/streams/offline
DATA_DIR=/app/data

# === FFmpeg ===
FFMPEG_BIN=/usr/bin/ffmpeg
HLS_TIME=4
HLS_LIST_SIZE=6
