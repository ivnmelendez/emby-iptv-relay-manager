# .env para desarrollo local (uvicorn en Mac, sin Docker)
# Copia esto como backend/.env y completa credenciales IPTV

BASE_URL=http://localhost:8000

# Proveedor IPTV
IPTV_HOST=http://tu-proveedor:puerto
IPTV_USERNAME=tu_usuario
IPTV_PASSWORD=tu_password

# Filtros
GROUP_FILTERS=["EVENTOS","SPORTS","DEPORT","PPV","LIVE"]
MAX_ACTIVE_STREAMS=3

# Paths locales (relativas al directorio backend/)
STREAMS_DIR=../streams
DATA_DIR=../data

# FFmpeg local (verifica con: which ffmpeg)
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg

HLS_TIME=4
HLS_LIST_SIZE=6
