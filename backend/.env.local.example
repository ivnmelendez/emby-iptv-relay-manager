# .env para desarrollo local (uvicorn en Mac, sin Docker)
# Copia esto como backend/.env y completa tus credenciales IPTV

BASE_URL=http://localhost:8000

# Proveedor IPTV
IPTV_HOST=http://tu-proveedor:puerto
IPTV_USERNAME=tu_usuario
IPTV_PASSWORD=tu_password

# Filtros (ajusta según tu proveedor)
GROUP_FILTERS=["EVENTOS","SPORTS","DEPORT","PPV","LIVE"]

MAX_ACTIVE_STREAMS=3

# Rutas locales (relativas al directorio backend/)
DATA_DIR=../data
HLS_DIR=../streams/live
OFFLINE_DIR=../streams/offline

# FFmpeg local (verifica con: which ffmpeg)
FFMPEG_BIN=/usr/local/bin/ffmpeg

HLS_TIME=4
HLS_LIST_SIZE=6
